@startuml
set separator none
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "SansSerif"
skinparam defaultFontSize 12
skinparam packageStyle folder
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #333333
skinparam packageFontStyle bold
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #FFFFFF
skinparam classBorderColor #333333
skinparam arrowColor #333333
skinparam arrowFontColor #222222
skinparam noteBackgroundColor #FAFAFA
skinparam noteBorderColor #666666

package "UsuarioRepoPort" as pkg_usuario_repo_port {
    interface UsuarioRepoPort {
        + salvar(usuario: Usuario) : Promise<void>
        + buscarPorId(id: string) : Promise<Usuario | null>
        + buscarPorEmailOuMatricula(identificador: string) : Promise<Usuario | null>
        + listar(perfil?: Perfil) : Promise<Usuario[]>
    }

    abstract class Usuario {
        - id : string
        - nome : string
        - email : string
        - documento : string
        - senhaHash : string
        - perfil : Perfil
        + possuiPerfil(perfil: Perfil) : boolean
    }

    class Aluno extends Usuario {
        + matricula : string
    }

    class Professor extends Usuario {
    }

    UsuarioRepoPort ..> Usuario : persiste e recupera
}

caption \n<size:15><b>Code View: Sistema de Gestão Escolar - UsuarioRepoPort</b></size>
@enduml
