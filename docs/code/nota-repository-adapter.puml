@startuml
set separator none
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "SansSerif"
skinparam defaultFontSize 12
skinparam packageStyle folder
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #333333
skinparam packageFontStyle bold
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #FFFFFF
skinparam classBorderColor #333333
skinparam arrowColor #333333
skinparam arrowFontColor #222222
skinparam noteBackgroundColor #FAFAFA
skinparam noteBorderColor #666666

package "sge.api.adapters.outbound.persistence.nota" {
    interface NotaRepoPort {
        + salvar(nota: Nota) : Promise<void>
        + atualizar(nota: Nota) : Promise<void>
        + buscarPorId(id: string) : Promise<Nota | null>
        + buscarPorMatricula(matriculaId: string) : Promise<Nota | null>
        + listarPorAlunoETurma(alunoId: string, turmaId: string) : Promise<Nota[]>
    }

    class NotaRepositoryAdapter implements NotaRepoPort {
        - db : DatabaseClient
        + salvar(nota: Nota) : Promise<void>
        + atualizar(nota: Nota) : Promise<void>
        + buscarPorId(id: string) : Promise<Nota | null>
        + buscarPorMatricula(matriculaId: string) : Promise<Nota | null>
        + listarPorAlunoETurma(alunoId: string, turmaId: string) : Promise<Nota[]>
        - mapRowToEntity(row: NotaRow) : Nota
    }

    interface DatabaseClient {
        + query<T>(sql: string, params?: unknown[]) : Promise<T[]>
        + execute(sql: string, params?: unknown[]) : Promise<void>
    }

    class NotaRow {
        ~ id : string
        ~ matricula_id : string
        ~ valor : number
    }

    NotaRepositoryAdapter --> "1" DatabaseClient : executa SQL
    NotaRepositoryAdapter ..> NotaRow : mapeia registro
}

caption \n<size:15><b>Code View: Sistema de Gestão Escolar - API de Gestão Escolar - NotaRepositoryAdapter</b></size>\n<size:11><color:#555555>Detalhes de implementação do adaptador secundário SQL de persistência de notas | Equipe 5 | UFC Quixadá</color></size>
@enduml
