@startuml
set separator none
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "SansSerif"
skinparam defaultFontSize 12
skinparam packageStyle folder
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #333333
skinparam packageFontStyle bold
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #FFFFFF
skinparam classBorderColor #333333
skinparam arrowColor #333333
skinparam arrowFontColor #222222
skinparam noteBackgroundColor #FAFAFA
skinparam noteBorderColor #666666

package "AvaliacaoController" as pkg_avaliacao_controller {
    interface LancarNotaPort {
        + executar(input: LancarNotaInput) : Promise<Nota>
    }

    interface ConsultarBoletimPort {
        + executar(alunoId: string) : Promise<Boletim[]>
    }

    class AvaliacaoController {
        - lancarNota : LancarNotaPort
        - consultarBoletim : ConsultarBoletimPort
        + postNota(req: Request, res: Response) : Promise<void>
        + putNota(req: Request, res: Response) : Promise<void>
        + getBoletim(req: Request, res: Response) : Promise<void>
    }

    class LancarNotaInput {
        + professorId : string
        + alunoId : string
        + turmaId : string
        + valor : number
    }

    class BoletimResponseDTO {
        + turmaId : string
        + disciplina : string
        + notas : number[]
        + media : number
        + situacao : string
    }

    AvaliacaoController ..> LancarNotaPort : POST/PUT /notas (RF08)
    AvaliacaoController ..> ConsultarBoletimPort : GET /boletim (RF10)
    AvaliacaoController ..> LancarNotaInput : monta entrada
    AvaliacaoController ..> BoletimResponseDTO : serializa JSON
}

caption \n<size:15><b>Code View: Sistema de Gestão Escolar - AvaliacaoController</b></size>
@enduml
