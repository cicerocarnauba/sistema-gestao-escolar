@startuml
set separator none
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "SansSerif"
skinparam defaultFontSize 12
skinparam packageStyle folder
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #333333
skinparam packageFontStyle bold
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #FFFFFF
skinparam classBorderColor #333333
skinparam arrowColor #333333
skinparam arrowFontColor #222222
skinparam noteBackgroundColor #FAFAFA
skinparam noteBorderColor #666666

package "AcademicoController" as pkg_academico_controller {
    interface CadastrarUsuarioPort {
        + executar(input: CadastrarUsuarioInput) : Promise<Usuario>
    }

    interface ListarUsuariosPort {
        + executar(filtroPerfil?: Perfil) : Promise<Usuario[]>
    }

    interface CriarTurmaPort {
        + executar(input: CriarTurmaInput) : Promise<Turma>
    }

    interface ConsultarTurmasPort {
        + executar(input: ConsultarTurmasInput) : Promise<Turma[]>
    }

    interface MatricularAlunoPort {
        + executar(input: MatricularAlunoInput) : Promise<Matricula>
    }

    class AcademicoController {
        - cadastrarUsuario : CadastrarUsuarioPort
        - listarUsuarios : ListarUsuariosPort
        - criarTurma : CriarTurmaPort
        - consultarTurmas : ConsultarTurmasPort
        - matricularAluno : MatricularAlunoPort
        + postUsuario(req: Request, res: Response) : Promise<void>
        + getUsuarios(req: Request, res: Response) : Promise<void>
        + postTurma(req: Request, res: Response) : Promise<void>
        + getTurmas(req: Request, res: Response) : Promise<void>
        + postMatricula(req: Request, res: Response) : Promise<void>
    }

    AcademicoController ..> CadastrarUsuarioPort : POST /usuarios (RF03)
    AcademicoController ..> ListarUsuariosPort : GET /usuarios (RF06)
    AcademicoController ..> CriarTurmaPort : POST /turmas (RF04)
    AcademicoController ..> ConsultarTurmasPort : GET /turmas (RF06, RF07, RF09)
    AcademicoController ..> MatricularAlunoPort : POST /matriculas (RF05)
}

caption \n<size:15><b>Code View: Sistema de Gestão Escolar - API de Gestão Escolar - AcademicoController</b></size>\n<size:11><color:#555555>Detalhes de implementação do adaptador REST para gestão de usuários, turmas e matrículas | Equipe 5 | UFC Quixadá</color></size>
@enduml
