@startuml
set separator none
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "SansSerif"
skinparam defaultFontSize 12
skinparam packageStyle folder
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #333333
skinparam packageFontStyle bold
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #FFFFFF
skinparam classBorderColor #333333
skinparam arrowColor #333333
skinparam arrowFontColor #222222
skinparam noteBackgroundColor #FAFAFA
skinparam noteBorderColor #666666

package "Gestão Acadêmica Core" as pkg_gestao_academica_core {
    interface CadastrarUsuarioPort {
        + executar(input: CadastrarUsuarioInput) : Promise<Usuario>
    }

    interface ListarUsuariosPort {
        + executar(filtroPerfil?: Perfil) : Promise<Usuario[]>
    }

    interface CriarTurmaPort {
        + executar(input: CriarTurmaInput) : Promise<Turma>
    }

    interface ConsultarTurmasPort {
        + executar(input: ConsultarTurmasInput) : Promise<Turma[]>
    }

    interface MatricularAlunoPort {
        + executar(input: MatricularAlunoInput) : Promise<Matricula>
    }

    class CadastrarUsuarioUseCase implements CadastrarUsuarioPort {
        - usuarioRepo : UsuarioRepoPort
        - authService : AuthServicePort
        + executar(input: CadastrarUsuarioInput) : Promise<Usuario>
    }

    class ListarUsuariosUseCase implements ListarUsuariosPort {
        - usuarioRepo : UsuarioRepoPort
        + executar(filtroPerfil?: Perfil) : Promise<Usuario[]>
    }

    class CriarTurmaUseCase implements CriarTurmaPort {
        - turmaRepo : TurmaRepoPort
        - usuarioRepo : UsuarioRepoPort
        + executar(input: CriarTurmaInput) : Promise<Turma>
    }

    class ConsultarTurmasUseCase implements ConsultarTurmasPort {
        - turmaRepo : TurmaRepoPort
        + executar(input: ConsultarTurmasInput) : Promise<Turma[]>
    }

    class MatricularAlunoUseCase implements MatricularAlunoPort {
        - turmaRepo : TurmaRepoPort
        - usuarioRepo : UsuarioRepoPort
        + executar(input: MatricularAlunoInput) : Promise<Matricula>
    }

    abstract class Usuario {
        - id : string
        - nome : string
        - email : string
        - documento : string
        - senhaHash : string
        - perfil : Perfil
        + possuiPerfil(perfil: Perfil) : boolean
    }

    class Aluno extends Usuario {
        + matricula : string
    }

    class Professor extends Usuario {
    }

    class Turma {
        - id : string
        - codigo : string
        - disciplina : string
        - periodoLetivo : string
        - professorId : string
        + professorETitular(professorId: string) : boolean
    }

    class Matricula {
        - id : string
        - alunoId : string
        - turmaId : string
        - ativa : boolean
        + estaAtiva() : boolean
        + encerrar() : void
    }

    CadastrarUsuarioUseCase ..> Usuario : cria Aluno / Professor
    ListarUsuariosUseCase ..> Usuario : consulta
    CriarTurmaUseCase ..> Turma : cria e vincula titular
    ConsultarTurmasUseCase ..> Turma : filtra por perfil
    MatricularAlunoUseCase ..> Matricula : garante unicidade (RN03)
    Turma "*" --> "1" Professor : tem titular
    Matricula "*" --> "1" Aluno : vincula
    Matricula "*" --> "1" Turma : vincula
}

caption \n<size:15><b>Code View: Sistema de Gestão Escolar - Gestão Acadêmica Core</b></size>
@enduml
