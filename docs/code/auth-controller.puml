@startuml
set separator none
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "SansSerif"
skinparam defaultFontSize 12
skinparam packageStyle folder
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #333333
skinparam packageFontStyle bold
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #FFFFFF
skinparam classBorderColor #333333
skinparam arrowColor #333333
skinparam arrowFontColor #222222
skinparam noteBackgroundColor #FAFAFA
skinparam noteBorderColor #666666

package "sge.api.adapters.inbound.http.auth" {
    interface AutenticarUsuarioPort {
        + executar(input: AutenticarUsuarioInput) : Promise<AutenticarUsuarioOutput>
    }

    interface AuthServicePort {
        + verificarToken(token: string) : TokenPayload
    }

    class AuthController {
        - autenticarUsuario : AutenticarUsuarioPort
        + login(req: Request, res: Response, next: NextFunction) : Promise<void>
    }

    class AuthMiddleware {
        - authService : AuthServicePort
        + autenticar(req: Request, res: Response, next: NextFunction) : void
        + exigirPerfis(perfis: Perfil[]) : RequestHandler
    }

    class LoginRequestDTO {
        + identificador : string
        + senha : string
    }

    class LoginResponseDTO {
        + token : string
        + usuario : UsuarioResumoDTO
    }

    AuthController ..> AutenticarUsuarioPort : aciona (RF01)
    AuthController ..> LoginRequestDTO : valida corpo
    AuthController ..> LoginResponseDTO : serializa JSON
    AuthMiddleware ..> AuthServicePort : valida Bearer JWT (RF02)
}

caption \n<size:15><b>Code View: Sistema de Gestão Escolar - API de Gestão Escolar - AuthController</b></size>\n<size:11><color:#555555>Detalhes de implementação do adaptador de entrada REST de autenticação e autorização RBAC | Equipe 5 | UFC Quixadá</color></size>
@enduml
