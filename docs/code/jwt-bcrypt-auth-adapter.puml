@startuml
set separator none
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam dpi 180
skinparam defaultFontName "SansSerif"
skinparam defaultFontSize 12
skinparam packageStyle folder
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #333333
skinparam packageFontStyle bold
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #FFFFFF
skinparam classBorderColor #333333
skinparam arrowColor #333333
skinparam arrowFontColor #222222
skinparam noteBackgroundColor #FAFAFA
skinparam noteBorderColor #666666

package "JwtBcryptAuthAdapter" as pkg_jwt_bcrypt_auth_adapter {
    interface AuthServicePort {
        + gerarHashSenha(senhaPura: string) : Promise<string>
        + compararSenha(senhaPura: string, senhaHash: string) : Promise<boolean>
        + gerarToken(payload: TokenPayload) : string
        + verificarToken(token: string) : TokenPayload
    }

    class JwtBcryptAuthAdapter implements AuthServicePort {
        - jwtSecret : string
        - jwtExpiresIn : string
        - saltRounds : number
        + gerarHashSenha(senhaPura: string) : Promise<string>
        + compararSenha(senhaPura: string, senhaHash: string) : Promise<boolean>
        + gerarToken(payload: TokenPayload) : string
        + verificarToken(token: string) : TokenPayload
    }

    class TokenPayload {
        + sub : string
        + email : string
        + perfil : Perfil
    }

    JwtBcryptAuthAdapter ..> TokenPayload : assina e decodifica
}

caption \n<size:15><b>Code View: Sistema de Gestão Escolar - JwtBcryptAuthAdapter</b></size>
@enduml
